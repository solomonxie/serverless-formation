{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "VisualEditor0",
            "Effect": "Allow",
            "Action": [
                "states:DescribeActivity",
                "states:DescribeExecution",
                "states:ListExecutions",
                "states:StartExecution",
                "states:StopExecution"
            ],
            "Resource": [
                "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:activity:*",
                "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:execution:prod-green-myapp-stepfunc-my_task:*",
                "arn:aws:states:${AWS_REGION}:${AWS_ACCOUNT_ID}:stateMachine:prod-green-myapp-stepfunc-my_task"
            ]
        }
    ]
}
